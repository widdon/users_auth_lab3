# Адрес API. Переменная без префикса NEXT_PUBLIC_, поэтому доступна только на сервере.
DUMMYJSON_URL=https://dummyjson.com

# Ключ шифрования сессии Auth.js (не короче 32 символов). Сгенерировать: npx auth secret
# При `npm run dev` / `npm run build` файл .env.local с этим ключом создаётся автоматически.
AUTH_SECRET=
